# Generate with: openssl rand -hex 32
LOOMI_ACCESS_KEY=
LOOMI_HOSTS=loomi.example.com;localhost;127.0.0.1
# Actual IP of the trusted reverse proxy as seen by the app/container.
LOOMI_PROXY_IP=172.17.0.1

# Optional. /dev/shm for the container; each connected account runs its own Chromium (~500MB).
# See the sizing table in README.md before raising the account count. Default: 2gb.
# LOOMI_SHM_SIZE=2gb

# Optional (Phase 4): Telegram bot token from @BotFather. Leave unset to keep the bot disabled;
# the app treats a missing token as "no bot configured" and stays silent about it.
# TELEGRAM_BOT_TOKEN=

# Optional (Phase 5): Gemini image-generation model name. Left empty here on purpose — Phase 5
# fills in the model name it validated against Google's current documentation. Do not guess it.
# GEMINI_MODEL=
