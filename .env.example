# Generate with: openssl rand -hex 32
LOOMI_ACCESS_KEY=
LOOMI_HOSTS=loomi.example.com;localhost;127.0.0.1
# Actual IP of the trusted reverse proxy as seen by the app/container.
# 172.17.0.1 (default Docker bridge gateway) is correct for a proxy on the host, such as
# deploy/nginx.conf. Set this to 172.28.0.9 instead when using `docker compose --profile caddy up -d`
# (deploy/Caddyfile) — see docs/DEPLOY.md.
LOOMI_PROXY_IP=172.17.0.1
# A proxy whose address changes, such as a platform's that is reattached to the network after each restart, is trusted by range instead:
# Security__KnownNetworks__0=172.16.0.0/12

# Required only for the optional Caddy profile (docker compose --profile caddy up -d): the single
# domain Caddy requests an automatic HTTPS certificate for. Must already resolve in DNS to this
# server. Leave unset if you use deploy/nginx.conf, or another proxy, instead.
# LOOMI_DOMAIN=loomi.example.com

# Optional. /dev/shm for the container; each connected account runs its own Chromium (~500MB).
# See the sizing table in README.md before raising the account count. Default: 2gb.
# LOOMI_SHM_SIZE=2gb

# Every other app setting goes here under its own name: docker-compose.yml hands this file to the
# container with env_file (Docker Compose 2.24 or newer), so these reach the app without a rebuild.

# Optional. Telegram bot token from @BotFather; without it the bot stays off and says nothing.
# Telegram__BotToken=
# Telegram__BotUsername=

# Optional. Gemini image model; the default gemini-3.1-flash-image was read from
# https://ai.google.dev/gemini-api/docs/image-generation. Change it only to another documented model.
# Gemini__Model=gemini-3.1-flash-image

# After ChatGPT changes its page, a selector can be replaced here without a rebuild (docs/DEPLOY.md):
# Browser__Selectors__Composer=div[contenteditable='true'][aria-label='Ask ChatGPT']

# Optional. The site's exact wording when an account's image allowance is spent, copied from a real
# reply, never guessed. A reply containing it moves the work to another account; any other reply in
# words goes back to the person who asked.
# Browser__SpentPhrases__0=
