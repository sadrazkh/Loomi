{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Storage": {
    "Root": "Storage"
  },
  "Security": {
    "KnownProxies": []
  },
  "Gemini": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/interactions",
    "Model": "gemini-3.1-flash-image",
    "ApiRevision": "",
    "TimeoutSeconds": 300
  },
  "Telegram": {
    "BotToken": "",
    "BotUsername": "",
    "PollSeconds": 30,
    "MediaGroupMs": 1500
  },
  "Browser": {
    "Headless": false,
    "NavigationTimeoutMs": 60000,
    "GenerationTimeoutSeconds": 600,
    "StableSeconds": 8,
    "Selectors": {
      "Composer": "#prompt-textarea, div[contenteditable='true'][aria-label='Ask ChatGPT'], form div[contenteditable='true'], div.ProseMirror[contenteditable='true']",
      "LoggedIn": "[data-testid='accounts-profile-button'], button[aria-label='Open profile menu'], button[aria-label*='profile menu']",
      "LoggedOut": "[data-testid='login-button'], [data-testid='mobile-login-button'], a[href*='/auth/login'], button[data-testid='signup-button']",
      "Send": "[data-testid='send-button'], button[aria-label='Send prompt'], button[aria-label^='Send']",
      "Stop": "[data-testid='stop-button'], button[aria-label='Stop streaming'], button[aria-label^='Stop streaming']",
      "Assistant": "[data-message-author-role='assistant']",
      "GeneratedImage": "[data-testid='generated-image-gallery'] img, button[data-testid='generated-image-preview'] img, img[alt*='Generated'], img[alt*='generated'], img[alt*='تصویر']",
      "FileInput": "input[type='file']",
      "AttachmentMenu": "button[aria-label*='Add files'], button[aria-label*='Add photos'], button[aria-label*='Attach'], button[data-testid='composer-plus-btn']",
      "UploadReady": "button[aria-label^='Remove'], button[aria-label*='Remove file'], button[aria-label*='Remove attachment']",
      "UploadBusy": "[role='progressbar']"
    }
  }
}
